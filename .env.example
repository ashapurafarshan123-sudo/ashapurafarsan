# ==============================================================================
# ASHAPURA FARSAN — ENVIRONMENT CONFIGURATION
# Copy this file to .env or .env.local for local development.
# Configure these variables in Netlify Dashboard under Site configuration > Environment variables.
# ==============================================================================

# Supabase Project URL (Public)
# Found in: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Publishable / safe for browser client)
# Found in: Supabase Dashboard > Project Settings > API > Project API Keys > anon (public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Production Site URL (Used for Supabase Auth redirect URLs)
# E.g. https://ashapurafarsan1.netlify.app or http://localhost:5173 during local dev
VITE_SITE_URL=https://ashapurafarsan1.netlify.app

# ------------------------------------------------------------------------------
# SECURITY NOTICE FOR OPERATORS & DEVELOPERS:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or database connection passwords in
# this file or any file committed to git. Service role keys bypass all Row Level
# Security (RLS) policies and must NEVER be exposed in frontend client bundles.
# ------------------------------------------------------------------------------
